# Browsers reject a manifest served as octet-stream; Netlify does not know the
# .webmanifest extension on its own.
/site.webmanifest
  Content-Type: application/manifest+json

# While the design is being reviewed, images must revalidate. A month of
# caching meant five different crops shipped under the same filename and no
# browser that had already seen one ever asked for another -- the site was
# correct and the reviewer was looking at a stale copy. build/set-indexing.mjs
# restores the long cache at launch, when the pictures stop changing.
/images/*
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/og-image.jpg
  Cache-Control: public, max-age=604800

# The document must revalidate or a redeploy never reaches anyone.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
