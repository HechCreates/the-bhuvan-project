# Browsers reject a manifest served as octet-stream; Netlify does not know the
# .webmanifest extension on its own.
/site.webmanifest
  Content-Type: application/manifest+json

# Photographs are stable, but not immutable: a month, so replacing one is not
# stuck in caches for a year.
/images/*
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/og-image.jpg
  Cache-Control: public, max-age=604800

# The document must revalidate or a redeploy never reaches anyone.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
